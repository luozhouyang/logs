---
/**
 * Landing page — a single interactive terminal.
 *
 * It plays a scripted tour (typed commands + output) that walks every section
 * and every post; typing takes over, and after `idleMs` of inactivity the tour
 * resumes. Content and copy are baked in at build time, so the page ships as
 * static HTML with one small script.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import { config } from "virtual:nimbus/config";
import { getLastUpdated } from "@cloudflare/nimbus-docs/runtime";
import { buildNav } from "../lib/blog-nav";
import { getCategoryFromId, loadEntries } from "../lib/content";
import { entryPath, localePath, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isZh = locale === "zh";
const home = localePath(locale, "/");

const nav = await buildNav(locale, home);
const sections = nav
  .filter((item) => item.type === "group")
  .map((group) => ({ slug: group.slug, label: group.label }));

const entries = await loadEntries(locale);
const posts = (
  await Promise.all(
    entries.map(async (entry) => {
      const date = entry.data.date ?? entry.data.lastUpdated ?? (await getLastUpdated(entry));
      return {
        id: entry.id,
        href: entryPath(locale, entry.id),
        title: entry.data.title,
        description: entry.data.description ?? "",
        date: date ? date.toISOString().slice(0, 10) : "",
        section: getCategoryFromId(entry.id),
      };
    }),
  )
).sort((a, b) => b.date.localeCompare(a.date));

const intro = isZh
  ? "关于 Cloudflare、Kong Gateway、Docker 与自建服务的笔记。"
  : "Notes on Cloudflare, Kong Gateway, Docker, and self-hosting.";

const copy = isZh
  ? {
      banner: ["luozhouyang's log — 交互式终端", "输入 help 查看命令 · 自动巡览正在进行"],
      auto: "自动",
      manual: "手动",
      resume: "# 空闲 — 恢复自动巡览（输入任意内容即可接管）",
      helpTitle: "可用命令：",
      help: [
        "ls [section]|列出主题，或某主题下的文章",
        "cat <post>|查看文章摘要",
        "open <post>|打开文章",
        "find <kw>|按标题或摘要搜索",
        "whoami|关于作者",
        "about|关于本站",
        "rss / llms|订阅与 agent 索引",
        "github|本站源码",
        "lang|切换中英文",
        "date / pwd / echo|常见命令",
        "clear|清屏",
      ],
      whoami: ["luozhouyang — 工程师", intro],
      about: [
        intro,
        "使用 Astro + Nimbus 构建，静态资源部署在 Cloudflare Workers。",
        `${posts.length} 篇文章 · ${sections.length} 个主题 · 2 种语言`,
      ],
      posts: "篇",
      lsHint: "→ 可以试试：ls <section>、cat <post>、open <post>",
      opening: "打开",
      notFound: "命令不存在：",
      tryHelp: "输入 help 查看可用命令。",
      noSection: "没有这个主题：",
      noPost: "没有这篇文章：",
      usage: "用法：",
      findNothing: "没有匹配：",
      langCurrent: "当前：",
      langSwitch: "切换：",
    }
  : {
      banner: ["luozhouyang's log — interactive shell", "type 'help' for commands · the tour is running"],
      auto: "auto",
      manual: "manual",
      resume: "# idle — resuming the tour (type to take over)",
      helpTitle: "commands:",
      help: [
        "ls [section]|list topics, or the posts in one",
        "cat <post>|show a post's summary",
        "open <post>|open a post",
        "find <kw>|search titles and summaries",
        "whoami|who writes this log",
        "about|about the site",
        "rss / llms|feed and agent index",
        "github|source of this site",
        "lang|switch language",
        "date / pwd / echo|the usual",
        "clear|clear the screen",
      ],
      whoami: ["luozhouyang — engineer", intro],
      about: [
        intro,
        "Built with Astro + Nimbus, served as static assets on Cloudflare Workers.",
        `${posts.length} posts · ${sections.length} topics · 2 languages`,
      ],
      posts: "posts",
      lsHint: "→ try: ls <section>, cat <post>, open <post>",
      opening: "opening",
      notFound: "command not found:",
      tryHelp: "type 'help' for the command list.",
      noSection: "no such section:",
      noPost: "no such post:",
      usage: "usage:",
      findNothing: "no matches:",
      langCurrent: "current:",
      langSwitch: "switch:",
    };

const terminalData = {
  locale,
  home,
  prompt: { user: "luozhouyang@edge", path: "~/log" },
  sections,
  posts,
  links: {
    rss: localePath(locale, "/rss.xml"),
    llms: localePath(locale, "/llms.txt"),
    github: config.github ?? "https://github.com/luozhouyang",
    other: isZh
      ? { href: localePath("en", "/"), label: "english" }
      : { href: localePath("zh", "/"), label: "中文" },
  },
  copy,
  idleMs: 10000,
};

const json = JSON.stringify(terminalData).replace(/</g, "\\u003c");
---

<BaseLayout
  title={config.title}
  description={intro}
  locale={isZh ? "zh-CN" : undefined}
>
  <div class="flex min-h-screen flex-col">
    <Header showSidebar={false} />

    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-5 sm:px-6 sm:py-8">
      <section
        data-terminal
        data-idle-ms={terminalData.idleMs}
        aria-label={isZh ? "终端" : "Terminal"}
        class="overflow-hidden rounded-xl border border-white/10 bg-[#0d1117] shadow-lg"
      >
        <!-- Title bar: the h1 lives here so the page keeps one real heading. -->
        <div class="flex items-center gap-3 border-b border-white/10 px-4 py-2.5">
          <span class="flex gap-1.5" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f56]/80"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#ffbd2e]/80"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#27c93f]/80"></span>
          </span>
          <h1 class="truncate font-mono text-[12px] font-medium text-white/70">
            {config.title}<span class="text-white/30"> — {terminalData.prompt.user}:{terminalData.prompt.path}</span>
          </h1>
          <span class="ml-auto flex items-center gap-2 font-mono text-[10px] uppercase tracking-wider text-white/30">
            <span data-term-status class="term-status" data-state="auto">{copy.auto}</span>
            <span aria-hidden="true">zsh</span>
          </span>
        </div>

        <!-- Scrollback -->
        <div
          data-term-screen
          class="term-screen px-4 py-4 font-mono text-[12.5px] leading-relaxed sm:text-[13px]"
        >
          <div data-term-output role="log" aria-live="off" aria-label={isZh ? "终端输出" : "Terminal output"}></div>

          <noscript>
            <p class="term-out">This terminal needs JavaScript. All posts:</p>
            <ul class="term-out">
              {posts.map((post) => (
                <li><a class="term-link" href={post.href}>{post.title}</a></li>
              ))}
            </ul>
          </noscript>
        </div>

        <!-- Input line -->
        <form data-term-form class="flex items-center gap-2 border-t border-white/10 px-4 py-3 font-mono text-[12.5px] sm:text-[13px]">
          <label for="term-input" class="term-prompt select-none" aria-hidden="true">$</label>
          <input
            id="term-input"
            data-term-input
            name="command"
            type="text"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="go"
            aria-label={isZh ? "终端命令，输入 help 查看帮助" : "Terminal command, type help for help"}
            class="min-w-0 flex-1 border-0 bg-transparent p-0 text-[#e6edf3] caret-[#7ee787] outline-none placeholder:text-white/20"
            placeholder={isZh ? "输入命令…" : "type a command…"}
          />
          <span data-term-caret class="term-caret" aria-hidden="true">▍</span>
          <span class="hidden shrink-0 font-mono text-[10px] uppercase tracking-wider text-white/25 sm:inline">
            {isZh ? "回车执行" : "enter"}
          </span>
        </form>
      </section>

      <!-- Crawlable/a11y mirror of everything the terminal can reach. -->
      <nav class="sr-only" aria-label={isZh ? "全部文章" : "All posts"}>
        <h2>{isZh ? "全部文章" : "All posts"}</h2>
        {sections.map((section) => (
          <div>
            <h3>{section.label}</h3>
            <ul>
              {posts.filter((post) => post.section === section.slug).map((post) => (
                <li><a href={post.href}>{post.title}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </main>
  </div>
</BaseLayout>

<script type="application/json" id="terminal-data" is:inline set:html={json}></script>

<script>
  import { initTerminal } from "../scripts/terminal";

  const dataElement = document.getElementById("terminal-data");
  const root = document.querySelector<HTMLElement>("[data-terminal]");
  if (dataElement?.textContent && root) {
    initTerminal(root, JSON.parse(dataElement.textContent));
  }
</script>

<style is:global>
  .term-screen {
    height: calc(100dvh - 12rem);
    min-height: 320px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .term-line {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .term-prompt {
    color: #7ee787;
  }

  .term-cmd {
    color: #e6edf3;
  }

  .term-out {
    color: #c9d1d9;
  }

  .term-dim {
    color: #8b949e;
  }

  .term-title {
    color: #e6edf3;
    font-weight: 600;
  }

  .term-key {
    color: #d2a8ff;
  }

  /* Command column in `help` output: wide enough for the longest entry. */
  .term-col {
    display: inline-block;
    min-width: 19ch;
  }

  .term-err {
    color: #ff7b72;
  }

  .term-link {
    color: #79c0ff;
    text-decoration: underline;
    text-decoration-color: rgb(121 192 255 / 0.35);
    text-underline-offset: 3px;
  }

  .term-link:hover {
    text-decoration-color: currentColor;
  }

  .term-status {
    padding: 0.05rem 0.35rem;
    border-radius: 0.25rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    color: #7ee787;
  }

  .term-status[data-state="manual"] {
    color: #ffbd2e;
  }

  .term-caret {
    color: #7ee787;
    animation: term-blink 1.1s steps(1) infinite;
  }

  .term-caret.is-hidden {
    visibility: hidden;
  }

  @keyframes term-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .term-caret {
      animation: none;
    }
  }
</style>
