---
import { Icon } from "astro-icon/components";
import { Button } from "./ui/button";
import { LinkButton } from "./ui/link-button";
import { ThemeToggle } from "./ui/theme-toggle";
import { SearchTrigger } from "./ui/search";
import { config } from "virtual:nimbus/config";
import { getCollection } from "astro:content";
import { localeHome, localePath, otherLocale, parseLocale, ui } from "../lib/i18n";
import { stripBase } from "../lib/base";

interface Props {
  /** Astro collection id for the current page, forwarded from DocsLayout. */
  collection?: string;
  /** Astro entry id for the current page, forwarded from DocsLayout. */
  entryId?: string;
  /**
   * Whether the page has a sidebar to open. When `false`, the mobile
   * menu button is hidden. Default `true`.
   */
  showSidebar?: boolean;
}

const { showSidebar = true } = Astro.props;

// ---- Locale switch (the only non-stock addition to this component) ---------
// The header otherwise matches the Nimbus starter: no section tabs, title,
// search, GitHub, theme toggle, mobile menu.
const locale = parseLocale(Astro.url.pathname);
const alternate = otherLocale(locale);
const labels = ui[locale];

// Link the translated post when both collections carry the same entry id;
// otherwise fall back to the other locale's home.
const route = stripBase(Astro.url.pathname).replace(/\/+$/, "");
const withoutLocale = route === "/zh" ? "/" : route.replace(/^\/zh(\/|$)/, "/");
const entryId = withoutLocale.replace(/^\/+|\/+$/g, "");

let alternateHref = localeHome(alternate);
if (entryId) {
  const collection = alternate === "zh" ? "zh" : "docs";
  const entries = await getCollection(collection).catch(() => []);
  if (entries.some((entry) => entry.id === entryId)) {
    alternateHref = localePath(alternate, `/${entryId}/`);
  }
}
---

<header class="sticky top-0 z-30 border-b border-border bg-card/80 backdrop-blur-lg">
  <div class="mx-auto flex items-center justify-between h-14 px-4 lg:px-6">
    <div class="flex items-center gap-3">
      <a href={localeHome(locale)} class="group">
        <span class="font-semibold text-sm text-foreground group-hover:text-primary transition-colors">
          {config.title}
        </span>
      </a>
    </div>

    <div class="flex items-center gap-2">
      {config.search !== false && <SearchTrigger />}

      <a
        href={alternateHref}
        hreflang={alternate === "zh" ? "zh-CN" : "en"}
        lang={alternate === "zh" ? "zh-CN" : "en"}
        aria-label={labels.switchToLabel}
        title={labels.switchToLabel}
        class="inline-flex h-7 items-center rounded-md border border-border px-2 text-[0.75rem] font-medium text-muted-foreground no-underline transition-colors hover:bg-accent hover:text-foreground"
        data-lang-switch={alternate}
      >
        {labels.switchTo}
      </a>

      {config.github && (
        <LinkButton
          href={config.github}
          variant="minimal"
          shape="square"
          size="sm"
          aria-label="GitHub"
          target="_blank"
          rel="noopener"
          class="text-muted-foreground"
        >
          <Icon name="ph:github-logo" class="w-4 h-4" />
        </LinkButton>
      )}
      <ThemeToggle />
      {showSidebar && (
        <Button
          variant="ghost"
          shape="square"
          size="sm"
          icon="ph:list"
          aria-label="Open navigation"
          data-menu-btn
          class="lg:hidden text-muted-foreground"
        />
      )}
    </div>
  </div>
</header>
