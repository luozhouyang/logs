---
/**
 * English post page — the default locale, served at the site root.
 * Nimbus's own sidebar/breadcrumb/prev-next helpers drive it, as in the starter.
 */
import DocsLayout from "../layouts/DocsLayout.astro";
import {
  getBreadcrumbs,
  getDocsPageProps,
  getDocsStaticPaths,
  getEditUrl,
  getLastUpdated,
  getPrevNext,
  getRouteFlags,
  getSidebar,
  getTOC,
} from "@cloudflare/nimbus-docs";
import { components } from "../components";
import { translationsFor } from "../lib/blog-nav";

export const prerender = true;
export const getStaticPaths = getDocsStaticPaths;

const { entry, Content, headings } = await getDocsPageProps(Astro);

const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";

const { sidebar: sidebarOn, tableOfContents: tocOn } = await getRouteFlags(entry);

const sidebar = sidebarOn
  ? await getSidebar(currentSlug, { collection: entry.collection })
  : false;
const prevNext = await getPrevNext(currentSlug, {
  sidebarTree: sidebar === false ? [] : sidebar,
  overrides: { prev: entry.data.prev, next: entry.data.next },
});
const breadcrumbs = await getBreadcrumbs(currentSlug, { collection: entry.collection });
const editUrl = await getEditUrl(entry);
// Frontmatter wins; git is the fallback.
const lastUpdated = entry.data.lastUpdated ?? (await getLastUpdated(entry));
const tocConfig = entry.data.tableOfContents;
const toc = tocOn && tocConfig !== false ? getTOC(headings, tocConfig) : false;
const markdownUrl = `/${entry.id}/index.md`;
const socialImage = entry.data.socialImage ?? `/og/${entry.id}.png`;
const translations = await translationsFor("en", entry.id);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  mode={entry.data.mode}
  banner={entry.data.banner}
  head={entry.data.head}
  searchable={entry.data.searchable}
  noindex={entry.data.noindex}
  markdownUrl={markdownUrl}
  socialImage={socialImage}
  lastUpdated={lastUpdated}
  published={entry.data.date}
  editUrl={editUrl}
  draft={entry.data.draft}
  audience={entry.data.audience}
  collection={entry.collection}
  entryId={entry.id}
  lang={entry.data.lang ?? "en"}
  translations={translations}
>
  <Content components={components} />
</DocsLayout>
