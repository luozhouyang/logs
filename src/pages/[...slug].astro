---
/**
 * English post page — the default locale, served at the site root.
 * Nimbus's own sidebar/breadcrumb/prev-next helpers drive it, as in the starter.
 */
import DocsLayout from "../layouts/DocsLayout.astro";
import {
  getBreadcrumbs,
  getDocsPageProps,
  getDocsStaticPaths,
  getEditUrl,
  getLastUpdated,
  getPrevNext,
  getRouteFlags,
  getSidebar,
  getTOC,
} from "@cloudflare/nimbus-docs";
import { components } from "../components";
import { stripBase, withBase, withBaseDeep } from "../lib/base";

export const prerender = true;
export const getStaticPaths = getDocsStaticPaths;

const { entry, Content, headings } = await getDocsPageProps(Astro);

const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";
// Nimbus compares nav links against a root-relative path, so hand it the
// route without the deployment base; the hrefs are re-prefixed below.
const routeSlug = stripBase(currentSlug);

const { sidebar: sidebarOn, tableOfContents: tocOn } = await getRouteFlags(entry);

// Nimbus 0.8 predates `base`: it builds root-relative nav links and compares
// them against a root-relative path. Build with the stripped path, then prefix
// the links for /logs — prev/next must read the *unprefixed* tree, or it can't
// find the current page.
const rawSidebar = sidebarOn
  ? await getSidebar(routeSlug, { collection: entry.collection })
  : false;
const sidebar = rawSidebar === false ? false : withBaseDeep(rawSidebar);
const prevNext = withBaseDeep(
  await getPrevNext(routeSlug, {
    sidebarTree: rawSidebar === false ? [] : rawSidebar,
    overrides: { prev: entry.data.prev, next: entry.data.next },
  }),
);
const breadcrumbs = withBaseDeep(
  await getBreadcrumbs(routeSlug, { collection: entry.collection }),
);
const editUrl = await getEditUrl(entry);
// Frontmatter wins; git is the fallback.
const lastUpdated = entry.data.lastUpdated ?? (await getLastUpdated(entry));
const tocConfig = entry.data.tableOfContents;
const toc = tocOn && tocConfig !== false ? getTOC(headings, tocConfig) : false;
const markdownUrl = withBase(`/${entry.id}/index.md`);
const socialImage = entry.data.socialImage
  ? withBase(entry.data.socialImage)
  : withBase(`/og/${entry.id}.png`);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  mode={entry.data.mode}
  banner={entry.data.banner}
  head={entry.data.head}
  searchable={entry.data.searchable}
  noindex={entry.data.noindex}
  markdownUrl={markdownUrl}
  socialImage={socialImage}
  lastUpdated={lastUpdated}
  editUrl={editUrl}
  draft={entry.data.draft}
  audience={entry.data.audience}
  collection={entry.collection}
  entryId={entry.id}
>
  <Content components={components} />
</DocsLayout>
