---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import { Badge } from "../../components/ui/badge";
import { getTags } from "../../lib/taxonomy";

const tags = await getTags();
---

<BaseLayout title="Tags" description="Browse posts by tag.">
  <div class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1 mx-auto max-w-2xl w-full px-6 py-16">
      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        Tags
      </h1>
      <p class="mt-2 text-[1.0625rem] text-muted-foreground leading-relaxed">
        Browse posts by tag.
      </p>

      <div class="mt-8 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <a href={`/tags/${tag.slug}/`} class="no-underline">
            <Badge size="medium" class="cursor-pointer hover:opacity-80 transition-opacity">
              {tag.label}
              <span class="ml-1 opacity-60">{tag.count}</span>
            </Badge>
          </a>
        ))}
      </div>
    </main>
  </div>
</BaseLayout>
