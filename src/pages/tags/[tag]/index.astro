---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import { Badge } from "../../../components/ui/badge";
import { getTags, getPostsByTag } from "../../../lib/taxonomy";

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { label: tag.label },
  }));
}

const { tag } = Astro.params;
const { label } = Astro.props;
const posts = await getPostsByTag(tag!);
---

<BaseLayout title={label} description={`Posts tagged with ${label}.`}>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1 mx-auto max-w-2xl w-full px-6 py-16">
      <nav class="text-sm text-muted-foreground mb-4">
        <a href="/tags/" class="hover:text-foreground transition-colors no-underline">Tags</a>
        <span class="mx-1.5">/</span>
        <span class="text-foreground">{label}</span>
      </nav>

      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        {label}
      </h1>
      <p class="mt-2 text-[1.0625rem] text-muted-foreground leading-relaxed">
        {posts.length} post{posts.length === 1 ? "" : "s"}
      </p>

      <div class="mt-8 flex flex-col gap-4">
        {posts.map((post) => (
          <a
            href={post.slug}
            class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
          >
            <div class="font-medium text-foreground">{post.title}</div>
            {post.description && (
              <div class="mt-0.5 text-sm text-muted-foreground">{post.description}</div>
            )}
            {post.tags.length > 0 && (
              <div class="mt-2 flex flex-wrap gap-1.5">
                {post.tags.map((t) => (
                  <Badge text={t} size="small" />
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    </main>
  </div>
</BaseLayout>
