---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import { LinkCard } from "../../components/ui/link-card";
import { config } from "virtual:nimbus/config";
import { getCategories } from "../../lib/taxonomy";
import { ui } from "../../lib/i18n";

const categories = await getCategories("zh");
const labels = ui.zh;
---

<BaseLayout
  title={config.title}
  description="关于 Cloudflare、Kong Gateway、Docker 与自建服务的笔记。"
  lang="zh-CN"
  translations={{ en: "/" }}
>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1 mx-auto max-w-2xl w-full px-6 py-24">
      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        {config.title}
      </h1>
      <p class="mt-2 text-[1.0625rem] text-muted-foreground leading-relaxed">
        关于 Cloudflare、Kong Gateway、Docker 与自建服务的笔记。
      </p>

      <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {categories.map((cat) => (
          <LinkCard
            title={cat.label}
            description={labels.postCount(cat.count)}
            href={`/zh/categories/${cat.slug}/`}
          />
        ))}
      </div>
    </main>
  </div>
</BaseLayout>
